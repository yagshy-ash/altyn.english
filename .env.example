# Supabase → Connect
# Uygulama: Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.PROJE_ID:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Migration: Session pooler veya Direct connection (port 5432)
DIRECT_URL="postgresql://postgres.PROJE_ID:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Oturum çerezlerini imzalamak için gizli anahtar
SESSION_SECRET=""

# Claude API anahtarı (yazma değerlendirmesi ve içerik üretimi)
ANTHROPIC_API_KEY=""

# İlk öğretmen hesabı (npm run db:seed ile oluşturulur)
TEACHER_USERNAME="ogretmen"
TEACHER_PASSWORD="degistir-beni"
TEACHER_NAME="Öğretmen"
